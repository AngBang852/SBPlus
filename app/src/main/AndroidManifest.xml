<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 2026-11-20 新增：安装产出的 APK 需要它。
         缺这个权限时 PackageInstaller.commit() 直接失败（连安装确认界面都不会弹），
         表现为「点安装没反应」。用户还需在系统设置里为本应用打开「安装未知应用」。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 2026-11-19：产物输出到公共下载目录 /sdcard/Download/SBPlus/。
         Android 10+ 走 MediaStore 不需要权限；API 26-28 需要 WRITE_EXTERNAL_STORAGE。
         maxSdkVersion=28 让它在更高版本上不申请（避免用户看到无意义的权限项）。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 日志写入用签名级权限:只有与模块同签名的 APK 才能调用 LogProvider。
         浏览器进程内的 hook 通过 ContentResolver 访问 provider —— 它属于三星浏览器
         (不同 UID、不同签名),但 ContentResolver 调用走的是"调用方进程的权限",
         因此这里必须允许跨应用访问,故对该权限声明 protectionLevel="signature"
         只能防住第三方 App。对三星浏览器本身的访问由下面的 extra 白名单兜住。 -->
    <permission
        android:name="com.sbplus.browser.permission.ACCESS_LOG"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.sbplus.browser.permission.ACCESS_LOG" />

    <!-- allowBackup 关闭的原因:本模块的 SharedPreferences 保存 UA 伪装、Cookie 导入、
         下载器接管等配置,日志库则保存页面 URL 与接口参数。allowBackup="true" 时,
         在已 root(装 LSPosed 的前置条件)的设备上可通过 adb backup / 云备份把这些
         数据完整带离设备,绕过应用沙箱;换机恢复还会把旧 Cookie 静默带到新设备。
         若日后确需恢复备份能力,必须用 android:dataExtractionRules 显式排除
         sharedpref / database / file 三个域,而不是直接打开这个开关。 -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/module_desc"
        android:supportsRtl="true"
        android:theme="@style/Theme.SBPlus">

        <!-- Launcher entry / settings screen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Log store: the hook (browser process) reports logs to this app via provider.

             越权防护说明(重要):这里**不能**用 android:permission="...signature"——
             框架会在进入 provider 之前就做权限校验,而合法的调用方是三星浏览器
             (不同签名、不同 UID),加了 signature 会让 hook 再也写不进日志。
             因此真正的准入控制放在 LogProvider.assertCallerAllowed() 里:
             只放行「本进程 / 持签名级权限者 / 三星浏览器包名白名单」,其余一律
             SecurityException。这样既保住功能,又挡掉第三方 App 读取 hook 调试日志
             (含页面 URL 与接口参数)、伪造日志、或一次性清空全部日志。 -->
        <provider
            android:name=".LogProvider"
            android:authorities="com.sbplus.browser.log"
            android:exported="true" />

        <!-- 2026-11-19：安装 APK 改用 PackageInstaller，不再需要 FileProvider。
             （androidx.core 会注册 CoreComponentFactory，导致 LogProvider 加载失败、
              app 启动即崩 —— 实测踩过。）这里只留安装结果接收器。 -->
        <receiver
            android:name=".patcher.InstallResultReceiver"
            android:exported="false" />

        <!-- 2026-11-19 新增：免 root 打补丁主入口。
            2026-11-22 审查 H2：改为 exported="false"。
            原先是 true，且 Activity 入口没有任何调用方校验 —— 任意第三方应用都能
            直接把这个"选 APK → 签名 → 引导安装"的界面推到用户面前，配合本模块的
            REQUEST_INSTALL_PACKAGES 可被用于诱导安装链（用户看到的是他信任的
            SBPlus 界面）。唯一入口是 MainActivity 的「免 root 打补丁」按钮，
            不需要外部唤起。 -->
        <activity
            android:name=".patcher.PatchActivity"
            android:exported="false"
            android:label="免 root 打补丁"
            android:parentActivityName=".MainActivity" />
        <!-- 2026-11-19 新增：将注入的功能子页（只读清单） -->
        <activity
            android:name=".patcher.PatchFeatureActivity"
            android:exported="false"
            android:label="将注入的功能"
            android:parentActivityName=".patcher.PatchActivity" />


        <!-- Log manager UI -->
        <activity
            android:name=".LogManagerActivity"
            android:exported="false"
            android:label="日志管理" />

    </application>

</manifest>
