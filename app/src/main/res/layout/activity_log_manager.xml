<?xml version="1.0" encoding="utf-8"?>
<!--
  日志管理页（2026-10-04 界面重构）。

  与 activity_main.xml 同一套视觉语言：卡片分组 + 统一配色 + 主次按钮。
  按"保留策略 / 日志操作 / 日志内容"三块分组，取代原来一串平铺控件。

  有意**不**放进 XML 的部分（仍是代码设置，因为是运行时数据或行为）：
    · 两个 EditText 的初值（读自 SharedPreferences）
    · 日志正文 TextView 的文本
    · 全部点击监听

  控件 id 保持不变（et_keep_days / et_max_mb / btn_save / btn_view /
  btn_export / btn_delete / tv_logs），LogManagerActivity 逻辑无需改动。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ========== 标题 ========== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日志管理"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:text="查看、导出与清理模块运行日志"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- ========== 卡片 1：保留策略 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保留策略"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="保留天数"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="超过此天数的日志自动删除"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_keep_days"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="默认 7 天"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="容量上限（MB）"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="日志总大小超过此值，自动删除最早的日志"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_max_mb"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="默认 10 MB"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_input" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="保存设置"
                android:textAllCaps="false"
                android:textColor="@color/text_on_brand"
                android:textSize="14sp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ========== 卡片 2：日志操作 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志操作"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_view"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="刷新"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btn_export"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="导出"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btn_delete"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="删除"
                    android:textAllCaps="false"
                    android:textColor="@color/warning"
                    android:textSize="13sp"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========== 卡片 3：日志内容 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志内容"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/tv_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:textIsSelectable="true"
                android:textSize="11sp"
                android:textColor="@color/code_text"
                android:typeface="monospace"
                android:lineSpacingExtra="2dp"
                android:text="点击「刷新」以查看" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>