<?xml version="1.0" encoding="utf-8"?>
<!--
  可点击文本的颜色（2026-10-04 界面重构）。
  用于版本号：检测更新期间 MainActivity 会 setEnabled(false)，
  此时文字变灰，配合 bg_row_clickable 的禁用态一起给出"正在检测"的视觉反馈。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_tertiary" />
    <item android:color="@color/brand" />
</selector>