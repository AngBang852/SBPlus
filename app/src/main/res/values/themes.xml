<?xml version="1.0" encoding="utf-8"?>
<!--
  SBPlus 主题（2026-10-04 界面重构）。

  为什么需要它：原布局把颜色硬编码在每个控件上，且未声明主题，
  于是状态栏、导航栏沿用系统默认（浅色页面配浅色状态栏文字会看不清，
  深色模式更是完全失控）。这里统一声明，配合 values-night 自动适配。

  注意：**不能**继承 Theme.Material.* 或 Theme.AppCompat.* ——
  本项目没有 Material/AppCompat 依赖，继承会直接编译失败。
  故继承系统自带的 @android:style/Theme.DeviceDefault.Light.NoActionBar。
-->
<resources>

    <style name="Theme.SBPlus" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- 状态栏与页面底同色，避免顶部出现一条突兀的色带 -->
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <!-- 浅色底用深色状态栏图标（API 23+） -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>