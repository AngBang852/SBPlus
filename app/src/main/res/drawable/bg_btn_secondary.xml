<?xml version="1.0" encoding="utf-8"?>
<!--
  次要操作按钮：透明底 + 细描边 + 圆角。
  与主按钮形成明确的视觉主次（现在两个按钮长得一样，用户看不出该点哪个）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/brand" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/outline_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_stroke" />
        </shape>
    </item>
</selector>