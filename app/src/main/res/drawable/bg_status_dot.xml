<?xml version="1.0" encoding="utf-8"?>
<!--
  激活状态圆点（2026-10-04 新增）。
  三态用不同颜色区分，配合 tv_status 的文字 —— 颜色是辅助，文字才是准的
  （色盲用户与截图场景都能读懂）。

  使用方式：MainActivity 按状态 setBackgroundResource 到具体颜色版本。
  此处提供的是默认态（灰 = 检测中）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/text_tertiary" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>